---
interface Props {
  name: string;
  image: string | { src: string };
  description: string;
}

const { name, image, description } = Astro.props;
const imgSrc = typeof image === 'string' ? image : image?.src;
---

<div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 sm:p-8 flex flex-col sm:flex-row items-center gap-6 max-w-xl mx-auto transition-transform hover:-translate-y-1 duration-200">
  {imgSrc && (
    <img
      src={imgSrc}
      alt={name}
      class="w-28 h-28 sm:w-32 sm:h-32 rounded-full object-cover shadow-md ring-4 ring-indigo-100 flex-shrink-0"
      loading="lazy"
    />
  )}
  <div class="text-center sm:text-left flex-1">
    <h3 class="text-2xl font-bold text-gray-900 tracking-tight">{name}</h3>
    <p class="mt-2 text-gray-600 text-sm sm:text-base leading-relaxed">
      {description}
    </p>
  </div>
</div>
